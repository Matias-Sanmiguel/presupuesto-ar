% --- Presupuesto ---
\newcommand{\PresupuestoEncabezado}[2]{%
  \par\vspace*{2mm}%
  {\footnotesize\sffamily\color{cobre}\bfseries PRESUPUESTO\par}%
  \vspace{2mm}\lineacobre\vspace{4mm}%
  {\sffamily\bfseries\Large #1\par}%
  \vspace{2mm}%
  {\small\color{muted}#2\par}%
  \vspace{3mm}\lineasuave\vspace{4mm}%
}

\newcommand{\NotaIva}{%
  {\small\color{muted}Precios a consumidor final en pesos argentinos (ARS), IVA incluido, según la ficha pública consultada.\par}%
}

\newcommand{\TotalPresupuesto}[1]{%
  \par\needspace{3\baselineskip}%
  \vspace{4mm}\lineacobre\vspace{3mm}%
  {\sffamily\bfseries\large Total estimado\quad\textcolor{cobre}{#1}\par}%
  {\footnotesize\color{muted}IVA incluido · referencia de mercado, no es orden de compra.\par}%
}

\newcommand{\NoEncontrado}[1]{%
  \par\noindent\textcolor{cobre}{\bfseries No encontrado:}\ #1\par%
}

