% --- Presupuesto ---
\newcommand{\PresupuestoEncabezado}[2]{%
  \par\vspace*{1mm}%
  {\color{cobre}\rule{\linewidth}{2.2pt}}\par\vspace{5mm}%
  {\sffamily\bfseries\fontsize{22}{26}\selectfont\color{slate}#1\par}%
  \vspace{3mm}%
  {\small\color{muted}#2\par}%
  \vspace{4mm}{\color{rule}\rule{\linewidth}{0.35pt}}\par\vspace{5mm}%
}

\newcommand{\NotaIva}{%
  {\small\color{muted}Importes en pesos argentinos (ARS), IVA incluido.\par}%
}

\newcommand{\TotalPresupuesto}[1]{%
  \par\needspace{4\baselineskip}%
  \vspace{6mm}%
  \noindent\begin{tikzpicture}
    \node[fill=sand,inner sep=10pt,text width=\dimexpr\linewidth-20pt\relax] {%
      {\sffamily\bfseries\large\color{slate}Total\quad\textcolor{cobredeep}{#1}\par}%
      \vspace{1mm}{\footnotesize\color{muted}IVA incluido\par}%
    };
  \end{tikzpicture}\par
}

\newcommand{\NoEncontrado}[1]{%
  \par\noindent\textcolor{cobredeep}{\bfseries No disponible:}\ \textcolor{muted}{#1}\par%
}

% Una fuente con 3 URLs obligatorias (entrega).
\newcommand{\FuenteTres}[5]{%
  \item \textbf{#1}\ \textcolor{muted}{·}\ #2\newline
  {\footnotesize\url{#3}\newline\url{#4}\newline\url{#5}}%
}
\newcommand{\FuenteItem}[3]{%
  \item \textbf{#1}\ \textcolor{muted}{·}\ #2\newline{\footnotesize\url{#3}}%
}

